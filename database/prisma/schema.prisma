// RecoverAI — Database Schema
// Phase 2: Data Layer Foundation
//
// This schema defines the persistence layer for the RecoverAI
// payment recovery intelligence platform.
//
// Models support: companies, users, providers, canonical payment events,
// failure information, recovery assessments, recommendations, attempts,
// outcomes, and ML predictions.
//
// No business logic is implemented at this layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

enum ProviderType {
  DEMO
  RAZORPAY
  STRIPE
  PAYPAL
  OTHER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
  BANK_TRANSFER
  OTHER
}

enum EventType {
  PAYMENT_CREATED
  PAYMENT_AUTHORIZED
  PAYMENT_COMPLETED
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  OTHER
}

enum FailureCategory {
  AUTHENTICATION
  INSUFFICIENT_FUNDS
  NETWORK
  BANK
  CARD
  PROVIDER
  CUSTOMER_ACTION_REQUIRED
  TEMPORARY
  UNKNOWN
}

enum RecoveryWorthiness {
  RECOVER
  DO_NOT_RECOVER
  REVIEW
}

enum RecommendationStatus {
  RECOMMENDED
  PENDING
  ACCEPTED
  REJECTED
  EXECUTED
  EXPIRED
}

enum RecoveryAttemptStatus {
  NOT_ATTEMPTED
  RECOMMENDED
  ATTEMPTED
  SUCCESSFUL
  FAILED
  CANCELLED
  EXPIRED
  UNKNOWN
}

enum BusinessTransactionStatus {
  PENDING
  FAILED
  SUCCESSFUL
  RECOVERED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RecoveryAttribution {
  NONE
  CUSTOMER
  RECOVERAI
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// An authorized dashboard user.
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// A payment provider or integration source (Demo, Razorpay, Stripe, etc.).
/// Provider-agnostic: no assumptions about a single provider.
model Provider {
  id        String       @id @default(cuid())
  type      ProviderType
  name      String
  isActive  Boolean      @default(true) @map("is_active")
  config    Json?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  payments PaymentEvent[]

  @@map("providers")
}

/// A business transaction grouping one or more payment attempts across provider orders.
model BusinessTransaction {
  id                  String                    @id @default(cuid())
  merchantReference   String?                   @map("merchant_reference")
  orderReference      String?                   @map("order_reference")
  amount              Decimal                   @db.Decimal(12, 2)
  currency            String                    @db.VarChar(3)
  status              BusinessTransactionStatus @default(PENDING)
  recoveryAttribution RecoveryAttribution       @default(NONE) @map("recovery_attribution")
  customerReference   String?                   @map("customer_reference")
  metadata            Json?
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  payments PaymentEvent[]

  @@unique([merchantReference], name: "merchant_ref_unique")
  @@index([orderReference])
  @@index([status])
  @@map("business_transactions")
}

/// A canonical payment event — provider-independent.
/// This is the contract between integrations and the RecoverAI core.
model PaymentEvent {
  id                    String        @id @default(cuid())
  externalPaymentId     String        @map("external_payment_id")
  providerId            String        @map("provider_id")
  businessTransactionId String?       @map("business_transaction_id")
  orderReference        String?       @map("order_reference")
  customerReference     String?       @map("customer_reference")
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @db.VarChar(3)
  status                PaymentStatus
  paymentMethod         PaymentMethod @default(OTHER) @map("payment_method")
  eventType             EventType     @map("event_type")
  failureCode           String?       @map("failure_code")
  failureMessage        String?       @map("failure_message")
  eventTimestamp        DateTime      @map("event_timestamp")
  metadata              Json?
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  provider            Provider                @relation(fields: [providerId], references: [id], onDelete: Restrict)
  businessTransaction BusinessTransaction?    @relation(fields: [businessTransactionId], references: [id], onDelete: SetNull)

  failure             PaymentFailure?
  assessment          RecoveryAssessment?
  recommendation      RecoveryRecommendation?
  attempts            RecoveryAttempt[]
  predictions         MlPrediction[]

  // Idempotency: prevent duplicate business records from the same provider event
  @@unique([providerId, externalPaymentId], name: "provider_external_unique")
  @@index([status])
  @@index([providerId])
  @@index([externalPaymentId])
  @@index([eventTimestamp])
  @@index([businessTransactionId])
  @@index([orderReference])
  @@map("payment_events")
}


/// Normalized payment failure information for a failed payment event.
model PaymentFailure {
  id             String          @id @default(cuid())
  paymentEventId String          @unique @map("payment_event_id")
  category       FailureCategory @default(UNKNOWN)
  failureCode    String?         @map("failure_code")
  failureMessage String?         @map("failure_message")
  failedAt       DateTime        @map("failed_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  paymentEvent PaymentEvent @relation(fields: [paymentEventId], references: [id], onDelete: Cascade)

  @@index([category])
  @@map("payment_failures")
}

/// Recovery-worthiness assessment for a payment event.
/// Stores whether recovery is recommended and the estimated recoverable amount.
/// Predicted/estimated values — NOT actual outcomes.
model RecoveryAssessment {
  id                       String             @id @default(cuid())
  paymentEventId           String             @unique @map("payment_event_id")
  worthiness               RecoveryWorthiness
  estimatedRecoverableAmount Decimal?         @db.Decimal(12, 2) @map("estimated_recoverable_amount")
  confidence               Float?
  reasoning                String?
  assessedAt               DateTime           @default(now()) @map("assessed_at")
  createdAt                DateTime           @default(now()) @map("created_at")

  paymentEvent PaymentEvent @relation(fields: [paymentEventId], references: [id], onDelete: Restrict)

  @@map("recovery_assessments")
}

/// A recommended recovery action for a payment event.
model RecoveryRecommendation {
  id             String               @id @default(cuid())
  paymentEventId String               @unique @map("payment_event_id")
  action         String
  status         RecommendationStatus @default(RECOMMENDED)
  reason         String?
  confidence     Float?
  createdAt      DateTime             @default(now()) @map("created_at")

  paymentEvent PaymentEvent @relation(fields: [paymentEventId], references: [id], onDelete: Restrict)

  @@map("recovery_recommendations")
}

/// Tracks the lifecycle of a recovery attempt.
model RecoveryAttempt {
  id                String                @id @default(cuid())
  paymentEventId    String                @map("payment_event_id")
  status            RecoveryAttemptStatus @default(NOT_ATTEMPTED)
  providerReference String?               @map("provider_reference")
  checkoutUrl       String?               @map("checkout_url")
  metadata          Json?
  attemptedAt       DateTime?             @map("attempted_at")
  completedAt       DateTime?             @map("completed_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  paymentEvent PaymentEvent     @relation(fields: [paymentEventId], references: [id], onDelete: Restrict)
  outcome      RecoveryOutcome?

  @@index([paymentEventId])
  @@index([status])
  @@index([providerReference])
  @@map("recovery_attempts")
}


/// Actual recovery result — separate from predictions/recommendations.
/// The distinction between estimated and actual values is critical.
model RecoveryOutcome {
  id                    String                @id @default(cuid())
  recoveryAttemptId     String                @unique @map("recovery_attempt_id")
  paymentEventId        String                @map("payment_event_id")
  outcome               RecoveryAttemptStatus
  actualRecoveredAmount Decimal?              @db.Decimal(12, 2) @map("actual_recovered_amount")
  outcomeTimestamp      DateTime              @map("outcome_timestamp")
  notes                 String?
  createdAt             DateTime              @default(now()) @map("created_at")

  recoveryAttempt RecoveryAttempt @relation(fields: [recoveryAttemptId], references: [id], onDelete: Restrict)

  @@index([paymentEventId])
  @@index([outcome])
  @@map("recovery_outcomes")
}

/// Persistence for ML model predictions — separate from deterministic assessments.
model MlPrediction {
  id             String       @id @default(cuid())
  paymentEventId String       @map("payment_event_id")
  modelVersion   String       @map("model_version")
  prediction     Json
  confidence     Float?
  createdAt      DateTime     @default(now()) @map("created_at")

  paymentEvent PaymentEvent @relation(fields: [paymentEventId], references: [id], onDelete: Restrict)

  @@index([paymentEventId])
  @@index([modelVersion])
  @@map("ml_predictions")
}