# RecoverAI — Environment Configuration
# Copy this file to .env and fill in your own values.
# Never commit the actual .env file to version control.

# Database — required when running Prisma commands (Phase 2+)
# The developer must create and manage their own PostgreSQL database.
# DATABASE_URL="postgresql://user:password@host:5432/recoverai?schema=public"

# Backend
BACKEND_PORT=4000

# Frontend
FRONTEND_URL="http://localhost:3000"

# ML Service (Phase 5+)
ML_SERVICE_URL="http://localhost:8000"

# Authentication (Phase 2+)
# AUTH_SECRET="generate-a-secure-random-secret"
